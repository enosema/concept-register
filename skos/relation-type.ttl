# Families

<urn:enosema:relation-family:hierarchical-generic> a skos:Collection ;
    dcterms:title "hierarchical-generic relation types"@en ;
    skos:member eno:broader_generic, eno:narrower_generic, eno:broader, eno:narrower ;
.

<urn:enosema:relation-family:hierarchical-partitive> a skos:Collection ;
    dcterms:title "hierarchical-partitive relation types"@en ;
    skos:member eno:broader_partitive, eno:narrower_partitive, eno:has_part, eno:is_part_of ;
.

<urn:enosema:relation-family:hierarchical-instantial> a skos:Collection ;
    dcterms:title "hierarchical-instantial relation types"@en ;
    skos:member eno:broader_instantial, eno:narrower_instantial, eno:instance_of, eno:has_instance ;
.

<urn:enosema:relation-family:equivalence-mapping> a skos:Collection ;
    dcterms:title "equivalence-mapping relation types"@en ;
    skos:member eno:equivalent, eno:exact_match, eno:close_match, eno:broad_match, eno:narrow_match, eno:related_match, eno:compare, eno:contrast ;
.

<urn:enosema:relation-family:associative-contiguity> a skos:Collection ;
    dcterms:title "associative-contiguity relation types"@en ;
    skos:member eno:enhances, eno:enhanced_by, eno:contains, eno:contained_by_container, eno:contained_by_contained, eno:attaches, eno:attached_to, eno:made_of, eno:material_of, eno:has_property, eno:property_of, eno:owns, eno:owned_by, eno:ranks_above, eno:ranks_below ;
.

<urn:enosema:relation-family:associative-sequential> a skos:Collection ;
    dcterms:title "associative-sequential relation types"@en ;
    skos:member eno:causes, eno:caused_by, eno:develops_into, eno:develops_from, eno:sequentially_related, eno:spatially_related, eno:temporally_related ;
.

<urn:enosema:relation-family:associative-activity> a skos:Collection ;
    dcterms:title "associative-activity relation types"@en ;
    skos:member eno:performed_by, eno:performs_action, eno:done_by_method, eno:method_of, eno:done_at, eno:place_of_action, eno:done_for_purpose, eno:purpose_of_action, eno:done_for_beneficiary, eno:beneficiary_of_action, eno:acts_on_object, eno:object_of_action, eno:done_with_tool, eno:tool_of_action, eno:acts_on_patient, eno:patient_of_action ;
